#!/usr/bin/env python3
"""Launcher symlinked into each test's temp dir; the case lives in a data file beside the link."""
import os
import pathlib
import runpy
import sys

# argv[0] is the symlink path, so its directory is the test's root.
root = pathlib.Path(os.path.abspath(sys.argv[0])).parent
case = (root / "case").read_text()
sys.argv[1:1] = [case, str(root)]
runpy.run_path(str(pathlib.Path(__file__).resolve().parent / "acp.py"), run_name="__main__")
